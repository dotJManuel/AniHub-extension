{
  "manifest_version": 3,
  "name": "AniHub — MAL + AniList Tracker",
  "version": "0.1.0",
  "description": "Autentica en MyAnimeList y AniList, ve tu lista actual en un solo lugar y sincroniza tu progreso en ambos a la vez.",
  "key": "",
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "AniHub"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://api.myanimelist.net/*",
    "https://myanimelist.net/*",
    "https://graphql.anilist.co/*",
    "https://api.jikan.moe/*"
  ]
}
